# Скопіюйте цей файл у ".env" (у цій же папці) і заповніть реальними значеннями.
# Сам ".env" НЕ комітиться в git (див. .gitignore).

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ===== Google Cloud / Sheets / Drive =====
GOOGLE_PROJECT_ID=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=
GOOGLE_DRIVE_FOLDER_ID=

# Де зберігати фото/відео і ЯК бот входить у Google (див. README):
# - "telegram" (за замовчуванням) - file_id у таблиці; доступ до Sheets через
#   сервісний акаунт (GOOGLE_SERVICE_ACCOUNT_FILE), без token.json;
# - "googledrive" - завантаження на Drive; OAuth token.json + google-oauth-client.json.
MEDIA_STORAGE=telegram

# Лише для MEDIA_STORAGE=telegram: JSON-ключ сервісного акаунта (завантажений
# з Google Cloud Console, перейменований на google-service-account.json).
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json

# Лише для MEDIA_STORAGE=googledrive: OAuth "Desktop app" і кеш token.json.
GOOGLE_OAUTH_CLIENT_FILE=google-oauth-client.json
GOOGLE_OAUTH_TOKEN_FILE=token.json

# ===== Контроль доступу =====
# Telegram ID користувачів, яким дозволено "➕ Додати об'єкт" і
# "✏️ Редагувати" (через кому). Залиште порожнім, щоб дозволити всім.
ADMINS=

# ===== Пошук =====
# Скільки об'єктів показувати за раз (кнопка "Показати ще" довантажує решту).
SEARCH_PAGE_SIZE=5

# Назви аркушів таблиці, які існують, але НЕ є населеними пунктами (довідники,
# зведені каталоги тощо) - через кому. Вони не з'являться у списку вибору
# населеного пункту в боті.
EXCLUDED_SHEETS=Довідники,Каталог,1
